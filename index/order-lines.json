{
  "settings": {
    "index": {
      "number_of_shards": 4,
      "number_of_replicas": 1,
      "refresh_interval": "10s",
      "max_ngram_diff": 14
    },
    "analysis": {
      "tokenizer": {
        "ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 17,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 16,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        "sku_tokenizer": {
          "type": "ngram",
          "min_gram": 2,
          "max_gram": 10,
          "token_chars": [
            "letter",
            "digit",
            "symbol",
            "punctuation"
          ]
        }
      },
      "analyzer": {
        "ngram_analyzer": {
          "type": "custom",
          "tokenizer": "ngram_tokenizer",
          "filter": [
            "lowercase"
          ]
        },
        "edge_ngram_analyzer": {
          "type": "custom",
          "tokenizer": "edge_ngram_tokenizer",
          "filter": [
            "lowercase"
          ]
        },
        "sku_analyzer": {
          "type": "custom",
          "tokenizer": "sku_tokenizer",
          "filter": [
            "lowercase"
          ]
        },
        "search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase"
          ]
        },
        "description_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "porter_stem",
            "english_stop"
          ]
        }
      },
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        }
      },
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "_deleted": {
        "type": "boolean"
      },
      "_deletedAt": {
        "type": "date",
        "format": "epoch_millis"
      },
      "orderLineKey": {
        "type": "keyword"
      },
      "orderHeaderKey": {
        "type": "keyword"
      },
      "primeLineNo": {
        "type": "integer"
      },
      "subLineNo": {
        "type": "integer"
      },
      "lineSeqNo": {
        "type": "keyword"
      },
      "lineType": {
        "type": "keyword"
      },
      "orderClass": {
        "type": "keyword"
      },
      "itemId": {
        "type": "keyword",
        "copy_to": "itemIdSearchable"
      },
      "itemIdSearchable": {
        "type": "text",
        "analyzer": "sku_analyzer",
        "search_analyzer": "search_analyzer"
      },
      "alternateItemId": {
        "type": "keyword"
      },
      "uom": {
        "type": "keyword"
      },
      "productClass": {
        "type": "keyword",
        "copy_to": "searchableText"
      },
      "productLine": {
        "type": "keyword",
        "copy_to": "searchableText"
      },
      "itemDescription": {
        "type": "text",
        "analyzer": "description_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword"
          },
          "ngram": {
            "type": "text",
            "analyzer": "ngram_analyzer",
            "search_analyzer": "search_analyzer"
          }
        }
      },
      "itemShortDescription": {
        "type": "text",
        "analyzer": "description_analyzer",
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "ngram_analyzer",
            "search_analyzer": "search_analyzer"
          }
        }
      },
      "upcCode": {
        "type": "keyword",
        "copy_to": "upcCodeSearchable"
      },
      "upcCodeSearchable": {
        "type": "text",
        "analyzer": "sku_analyzer",
        "search_analyzer": "search_analyzer"
      },
      "manufacturerName": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer"
          },
          "ngram": {
            "type": "text",
            "analyzer": "ngram_analyzer",
            "search_analyzer": "search_analyzer"
          },
          "autocomplete": {
            "type": "text",
