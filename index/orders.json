{
  "settings": {
    "index": {
      "number_of_shards": 4,
      "number_of_replicas": 1,
      "refresh_interval": "1s",
      "max_ngram_diff": 14
    },
    "analysis": {
      "tokenizer": {
        "ngram_tokenizer": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 17,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 16,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "analyzer": {
        "ngram_analyzer": {
          "type": "custom",
          "tokenizer": "ngram_tokenizer",
          "filter": [
            "lowercase"
          ]
        },
        "edge_ngram_analyzer": {
          "type": "custom",
          "tokenizer": "edge_ngram_tokenizer",
          "filter": [
            "lowercase"
          ]
        },
        "search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase"
          ]
        },
        "phone_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "char_filter": [
            "phone_char_filter"
          ],
          "filter": [
            "lowercase"
          ]
        },
        "order_no_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "char_filter": [
            "order_no_char_filter"
          ],
          "filter": [
            "lowercase"
          ]
        },
        "email_analyzer": {
          "type": "custom",
          "tokenizer": "uax_url_email",
          "filter": [
            "lowercase"
          ]
        }
      },
      "char_filter": {
        "phone_char_filter": {
          "type": "pattern_replace",
          "pattern": "[^0-9]",
          "replacement": ""
        },
        "order_no_char_filter": {
          "type": "pattern_replace",
          "pattern": "[^a-zA-Z0-9]",
          "replacement": ""
        }
      },
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
